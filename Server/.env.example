# ─── SERVER ───────────────────────────────────────────
PORT=8002
NODE_ENV=development

# ─── DATABASE ─────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/autoserve

# ─── AUTH ─────────────────────────────────────────────
ACCESS_TOKEN_SECRET=your_access_token_secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRY=7d

# ─── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
SOCKET_CORS_ORIGIN=http://localhost:5173

# ─── CLOUDINARY ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── EMAIL (SMTP) ─────────────────────────────────────
# Development: use Mailtrap (mailtrap.io)
# Production: use Resend or Brevo (both free tier)
ILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
ILTRAP_SMTP_PORT=587
ILTRAP_SMTP_USER=your_mailtrap_user
ILTRAP_SMTP_PASS=your_mailtrap_pass

# ─── RAZORPAY ─────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ─── DISPATCH ─────────────────────────────────────────
# Time in ms to wait for vendor acceptance before advancing to next batch
DISPATCH_BATCH_TIMEOUT_MS=60000
